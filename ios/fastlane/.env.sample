# Copy this file to .env.prod in the same folder and fill in the values (.env.prod is git-ignored).
#
# App Store Connect → Users and Access → Integrations → App Store Connect API.
# The private .p8 must never go into git (`*.p8` is ignored).
ASC_KEY_ID="YOUR_KEY_ID"
# The issuer, a UUID shown above the key list on the same page.
ASC_KEY_ISSUER_ID=""
# Path to AuthKey_XXXXXXXXXX.p8 (absolute or relative to ios/fastlane)
ASC_KEY_PATH="AuthKey_YOUR_KEY_ID.p8"

# Password of the team's .p12 certificates in ios/certificates/prod/, empty if they have none.
IOS_CERT_PASSWORD=""
